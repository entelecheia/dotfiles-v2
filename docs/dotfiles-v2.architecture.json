      "title": "Sync and schedule",
      "items": [
        "rsync push and intake runs via internal/syncer with rsync binary selection",
        "dot sync setup installs launchd LaunchAgent or systemd user-timer units",
        "cloudflared tunnel and SSH drop-ins managed under internal/tunnel"
      ]
    },
    {
      "dot": "emerald",
      "title": "Secrets and snapshots",
      "items": [
        "age-encrypted archives; encryptFile stages 0600 temp files only",
