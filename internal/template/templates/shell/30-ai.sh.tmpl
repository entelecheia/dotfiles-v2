{{ if .EnableAI -}}
# ── Claude Code ──
export ENABLE_LSP_TOOLS=1

# Codex full-access mode (no approval prompts or sandbox)
codex-yolo() {
  command codex --dangerously-bypass-approvals-and-sandbox "$@"
}

# Claude Code full-access mode (no permission prompts)
claude-yolo() {
  command claude --dangerously-skip-permissions "$@"
}

# Kiro full-access mode (all tools trusted, no approval prompts)
kiro-yolo() {
  command kiro-cli chat --trust-all-tools "$@"
}

# Copilot CLI full-access mode (all tools/paths/URLs allowed)
copilot-yolo() {
  command copilot --allow-all "$@"
}

# Kimi Code full-access mode (Never Ask). Since kimi-code 0.40, --yolo only means
# "Ask When Needed" (risky actions, questions, and plans still prompt); --auto is the
# never-interrupt mode that matches the other *-yolo helpers.
kimi-yolo() {
  command kimi --auto "$@"
}

# ── GitHub Models ──
command -v gh &>/dev/null && {
  alias g4="gh models run gpt-4o"
  alias p4="gh models run Phi-4"
}

# ── Fabric ──
command -v fabric &>/dev/null && alias fa="fabric"

# ── GPU monitoring ──
{{ if .HasNVIDIAGPU -}}
alias gpustat="nvidia-smi --query-gpu=index,name,utilization.gpu,memory.used,memory.total --format=csv"
alias gpuwatch="watch -n 1 nvidia-smi"
{{ end -}}
command -v pipx &>/dev/null && alias nvitop="pipx run nvitop"
{{ end -}}
