# dot watchdog monit control file, rendered by `dot watchdog setup`.
# Edit watchdog.monit in the active profile and rerun setup to change it.
set daemon 60
set logfile "/Users/test/Library/Logs/dot/monit.log"

check system $HOST
  if loadavg(5min) > 8 for 3 cycles then exec "/Users/test/.local/bin/dot watchdog notify warn 'monit: loadavg(5min) above 8 for 3 cycles'"
  if cpu(user) > 90% for 3 cycles then exec "/Users/test/.local/bin/dot watchdog notify warn 'monit: cpu(user) above 90% for 3 cycles'"
  if cpu(system) > 50% for 3 cycles then exec "/Users/test/.local/bin/dot watchdog notify warn 'monit: cpu(system) above 50% for 3 cycles'"

check host screensharing with address 127.0.0.1
  if failed port 5900 send "" expect "RFB" for 3 cycles then exec "/usr/bin/sudo -n '/Library/Application Support/dot/screensharing-heal'"
